# =============================================================================
#  docker compose configuration for the helpdesk stack.
#
#  Copy to .env NEXT TO compose.yaml, fill in, then lock it down:
#
#      cp deploy/env.example .env
#      chmod 600 .env
#
#  Everything about the application itself - identity provider, provisioning,
#  branding, attachment limits, ticket templates, local accounts - is
#  configured from the running application and stored in its database, not
#  here.
#
#  Note: on a development machine .env is read by the application itself and
#  looks different (see .env.example). In the compose stack the application's
#  configuration comes from compose.yaml; this file only fills the
#  placeholders in it.
# =============================================================================

# --- Required ----------------------------------------------------------------

# Public hostname. Must already resolve to this host, and ports 80 and 443 must
# be reachable from the internet, or the certificate cannot be issued.
HELPDESK_DOMAIN=helpdesk.example.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=it-operations@example.com

# Session signing key. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Also derives the key that encrypts stored client secrets, so changing it
# invalidates every session AND makes the stored identity-provider secrets
# unreadable - they must then be re-entered in Admin -> Settings.
SESSION_SECRET=

# --- Optional ----------------------------------------------------------------

SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
LOG_LEVEL=info

# Seed values for the first start only; all of these are editable in the UI
# afterwards and the stored value wins from then on.
PROVISIONING_JIT=true
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
