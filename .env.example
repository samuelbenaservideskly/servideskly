# =============================================================================
#  Helpdesk Ticketing System - configuration
#  Copy to .env and fill in. Never commit .env.
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Public base URL of this app. MUST be https:// in production.
# Used to build the OIDC redirect URI and the SCIM endpoint URL.
APP_BASE_URL=https://helpdesk.example.com

# Set to 1 (or a hop count) only when running behind a trusted reverse proxy
# that sets X-Forwarded-* headers. Leave empty when exposed directly.
TRUST_PROXY=

# Session signing keys, newest first, comma separated (enables key rotation).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# --- Database ---------------------------------------------------------------
# SQLite database file. Created on first start, along with its directory.
# Must be on real local disk: SQLite locking is unreliable on a network
# filesystem (an SMB/NFS mount, an Azure Files share), and two processes
# cannot share one file at all.
DATABASE_PATH=./data/ticketing.sqlite

# How long to wait for another writer before giving up. SQLite allows one
# writer at a time; this is the queue.
DATABASE_BUSY_TIMEOUT_MS=10000

# --- Uploaded files ---------------------------------------------------------
# Attachments and branding assets. Must be on persistent storage: in the
# compose stack this is the "data" named volume, mounted at /data.
UPLOAD_DIR=./data/uploads

# --- Local accounts ---------------------------------------------------------
# Accounts that sign in with a username and password rather than through
# Entra ID. The "admin" account always exists; it is what keeps the service
# administrable when single sign-on is broken or not configured yet.
#
# Outside production, this password is given to "admin" and to a second
# "user" account when they are first created, so a proof of concept can be
# signed into without reading the log. IGNORED in production, where a random
# password is generated and written to the log exactly once instead.
LOCAL_SEED_PASSWORD=

# Minimum password length. Production floors this at 12 whatever is set here.
PASSWORD_MIN_LENGTH=12
# --- Authentication ---------------------------------------------------------
# Single sign-on is Microsoft Entra ID over OpenID Connect. There is no other
# method and no sign-in bypass: a session needs either a verified Entra ID
# token or a local account password.
#
# Everything below is optional. It seeds the initial configuration, and all of
# it can be changed from Admin -> Settings at runtime without a restart. An
# installation may start with none of it set - the local administrator,
# created on first start, can then complete the setup through the UI.

# --- Entra ID: OpenID Connect / OAuth 2.0 -----------------------------------
# App registration -> Overview for the IDs, Certificates & secrets for the
# secret. Redirect URI to register (Web platform):
#   {APP_BASE_URL}/auth/oidc/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Space separated. openid+profile+email are required; offline_access is not used.
OIDC_SCOPES=openid profile email
# Optional extra allowed issuer values (comma separated) for multi-tenant setups.
OIDC_EXTRA_ISSUERS=

# --- Provisioning -----------------------------------------------------------
# Whether an account unknown to the service is created on its first successful
# sign-in. With it false, only accounts provisioned through the SCIM endpoint
# may sign in.
PROVISIONING_JIT=true

# SCIM is configured entirely in the UI: Admin -> Settings -> Provisioning
# generates the bearer token and shows the endpoint URL to paste into the
# Entra provisioning blade. There is nothing to set here.
#
# ROLES ARE NOT TAKEN FROM THE DIRECTORY. Group membership, app roles and
# addresses are all ignored. Everyone arrives as a plain user and is promoted
# under Admin -> Users. That is why there are no role-mapping variables.
# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
