<%- include('partials/header') %>

<div class="signin">
  <div class="card signin-card">
    <%- include("partials/signin-mark") %>
    <h1>Enter your password</h1>

    <% if (locals.justCreated) { %>
      <div class="flash flash--success" role="status">Your account is ready. Sign in with the password you chose.</div>
    <% } %>
    <% if (locals.justReset) { %>
      <div class="flash flash--success" role="status">Your password was changed. Sign in with the new one.</div>
    <% } %>

    <form method="post" action="/auth/local" class="stack local-signin">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
      <input type="hidden" name="returnTo" value="<%= returnTo %>">

      <%# The address from step one, as a chip. Still an input, and still
          sent, so a password manager knows which account this is. %>
      <div class="signin-identity">
        <span class="avatar" aria-hidden="true"><%= (email || '?').slice(0, 2).toUpperCase() %></span>
        <label for="email" class="visually-hidden">Email</label>
        <input id="email" name="email" type="email" readonly value="<%= email %>" autocomplete="username" class="signin-identity__email">
        <a class="signin-change" href="/login?change=1" title="Use a different address">Change<span class="visually-hidden"> - use a different address</span></a>
      </div>

      <%# Slides in under the address, as the second half of one form. %>
      <div class="field signin-reveal">
        <div class="label-row">
          <label for="password">Password</label>
          <a class="signin-forgot" href="/login/forgot">Forgot password?</a>
        </div>
        <input id="password" name="password" type="password" required maxlength="200"
               autocomplete="current-password" autofocus
               <%- error ? 'aria-describedby="password-error"' : '' %>>
        <% if (error) { %><p class="field-error" id="password-error" role="alert"><%= error %></p><% } %>
      </div>

      <button type="submit" class="btn btn--primary btn--block signin-reveal signin-reveal--late">Sign in</button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
