<%- include('partials/header') %>
<%
  var l = list;
  var scope = (l.scopeNames.length === 1 ? l.scopeNames[0] : t('All my groups')) + (l.unrouted ? ' ' + t('and unrouted tickets') : '');
  var company = l.company ? (l.company === noCompany ? t('No company') : l.company) : '';
%>

<%- include('partials/back-link', { href: backHref, label: t('Back to the report') }) %>

<div class="dash-hello">
  <div>
    <h1><%= t(l.title) %> <span class="report-count"><%= l.total %></span></h1>
    <p class="muted"><%= scope %><%= company ? ' - ' + company : '' %> - <%= formatDate(l.period.from) %> to <%= formatDate(new Date(l.period.to.getTime() - 1)) %><% l.narrowed.forEach(function (n) { %> - <%= n %><% }); %></p>
  </div>
</div>

<p class="report-definition small"><b><%= t('How this is counted.') %></b> <%= t(l.definition) %></p>
<% if (l.capped) { %><p class="small muted">The first <%= cap %> tickets raised in the period were read, as on the report.</p><% } %>

<section class="dash-panel">
  <%- include('partials/clear-columns', { state: listState, path: '/reports/tickets' }) %>
  <% if (l.rows.length === 0) { %>
    <p class="dash-empty"><%= t('No tickets.') %> <a href="<%= backHref %>"><%= t('Back to the report') %></a></p>
  <% } else { %>
    <div class="table-scroll">
      <table class="table">
        <thead>
          <tr>
            <%# Excel-like headers (partials/col-head.ejs). %>
            <% [
              { key: 'ticket', label: 'Ticket' }, { key: 'status', label: 'Status' }, { key: 'priority', label: 'Priority' },
              { key: 'group', label: 'Group' }, { key: 'assignee', label: 'Assignee' }, { key: 'company', label: 'Company' },
              { key: 'raised', label: 'Raised' }, { key: 'resolved', label: 'Resolved' },
            ].forEach(function (c) { %>
              <%- include('partials/col-head', { key: c.key, label: locals.t(c.label), path: '/reports/tickets', state: listState, menu: l.columnMenus[c.key] }) %>
            <% }); %>
          </tr>
        </thead>
        <tbody>
          <% l.rows.forEach(function (t) { %>
            <tr>
              <td>
                <a class="link-strong" href="/tickets/<%= t.id %>"><%= t.title %></a>
                <div class="small muted"><%= t.reference %> - <%= typeLabels[t.type] || t.type %> - <%= t.requester %></div>
                <% if (t.detail) { %><div class="report-why small"><%= t.detail %></div><% } %>
              </td>
              <td><span class="pill pill--<%= t.status %>"><%= statusLabels[t.status] %></span></td>
              <td><span class="pill pill--p-<%= t.priority %>"><%= priorityLabels[t.priority] %></span></td>
              <td class="small"><%= t.group %></td>
              <td class="small"><%= t.assignee || locals.t('Unassigned') %></td>
              <td class="small"><%= t.company || '-' %></td>
              <td class="small" title="<%= formatDateTime(t.createdAt) %>"><%= formatDate(t.createdAt) %></td>
              <td class="small"><%= t.resolvedAt ? formatDate(t.resolvedAt) : '-' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% if (l.pages > 1) { %>
      <nav class="pagination" aria-label="Pages">
        <% for (var p = 1; p <= l.pages; p++) { %>
          <% if (p === 1 || p === l.pages || Math.abs(p - l.page) <= 2) { %>
            <a href="<%= pageHref(p) %>" class="pagination__item<%= p === l.page ? ' pagination__item--current' : '' %>"<%- p === l.page ? ' aria-current="page"' : '' %>><%= p %></a>
          <% } else if (Math.abs(p - l.page) === 3) { %>
            <span class="pagination__gap" aria-hidden="true">...</span>
          <% } %>
        <% } %>
      </nav>
    <% } %>
  <% } %>
</section>

<%- include('partials/footer') %>
