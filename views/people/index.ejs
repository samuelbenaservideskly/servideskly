<%- include('../partials/header') %>

<div class="page-head">
  <h1>People</h1>
</div>

<%# The same search bar as the group lists: one field, a button, no script. %>
<form method="get" action="/people" class="filters">
  <%- include('../partials/keep-columns', { state: listState }) %>
  <span class="filters__field">
    <label for="q">Search</label>
    <input id="q" name="q" type="search" maxlength="200" value="<%= search %>" placeholder="Name or email">
  </span>
  <button type="submit" class="btn">Search</button>
  <% if (search) { %><a class="btn btn--quiet" href="/people">Clear</a><% } %>
  <% if (confined) { %>
    <%# A fact the control cannot show: why somebody is missing from this list. %>
    <span class="small muted">People at <%= company %> only.</span>
  <% } %>
</form>

<%- include('../partials/clear-columns', { state: listState, path: '/people' }) %>
<% if (!people.length) { %>
  <p class="empty"><%= search ? tx('Nobody matches "{0}".', [search]) : t('Nobody to show.') %></p>
<% } else { %>
  <div class="table-scroll">
    <table class="table">
      <thead>
        <tr>
          <%- include('../partials/col-head', { key: 'name', label: t('Name'), path: '/people', state: listState }) %>
          <%- include('../partials/col-head', { key: 'company', label: t('Company'), path: '/people', state: listState, menu: columnMenus.company }) %>
          <th scope="col">Department</th>
          <th scope="col">Job title</th>
          <th scope="col">Phone</th>
        </tr>
      </thead>
      <tbody>
        <% people.forEach(function (person) { %>
          <tr>
            <td>
              <a href="/people/<%= person.id %>"><%= person.display_name %></a>
              <div class="small muted"><%= person.email %></div>
            </td>
            <td class="small"><%= person.company || '-' %></td>
            <td class="small"><%= person.department || '-' %></td>
            <td class="small"><%= person.job_title || '-' %></td>
            <td class="small">
              <% if (person.phone) { %><a href="tel:<%= person.phone %>"><%= person.phone %></a><% } else { %>-<% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <% if (pages > 1) { %>
    <nav class="pagination" aria-label="Pages">
      <% if (page > 1) { %>
        <a class="btn btn--quiet" href="/people<%= queryString(Object.assign({}, listState, { page: page - 1 })) %>">Previous</a>
      <% } %>
      <span class="small muted">Page <%= page %> of <%= pages %></span>
      <% if (page < pages) { %>
        <a class="btn btn--quiet" href="/people<%= queryString(Object.assign({}, listState, { page: page + 1 })) %>">Next</a>
      <% } %>
    </nav>
  <% } %>
<% } %>

<%- include('../partials/footer') %>
