<% if (search.pageCount > 1) { %>
  <nav class="pagination" aria-label="Pages">
    <% for (var p = 1; p <= search.pageCount; p++) { %>
      <% if (p === 1 || p === search.pageCount || Math.abs(p - search.page) <= 2) { %>
        <%# Paging keeps the search, the sort and the column filters. %>
        <a href="<%= action %><%= queryString(Object.assign({}, locals.state || { q: search.q }, { page: p })) %>"
           class="pagination__item<%= p === search.page ? ' pagination__item--current' : '' %>"><%= p %></a>
      <% } else if (Math.abs(p - search.page) === 3) { %>
        <span class="pagination__gap" aria-hidden="true">...</span>
      <% } %>
    <% } %>
  </nav>
<% } %>
