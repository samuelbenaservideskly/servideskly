<%- include('_layout') %>

<%- include('_customization-tabs', { tab: 'images' }) %>

<div class="toolbar">
  <a class="btn btn--primary" href="#upload-image">
    <span aria-hidden="true">+</span> Upload image
  </a>
</div>

<% if (images.length === 0 && !q) { %>
  <div class="card">
    <p><strong>No images yet.</strong></p>
    <p class="small muted"><a href="#upload-image">Upload the first one.</a></p>
  </div>
<% } else { %>
  <%# Search by name: with a long list, finding one beats scrolling. %>
  <form method="get" action="/admin/settings/customization/images" class="filters">
    <span class="filters__field">
      <label for="q">Search</label>
      <input id="q" name="q" type="search" maxlength="80" value="<%= q %>" placeholder="Image name">
    </span>
    <button type="submit" class="btn">Search</button>
    <% if (q) { %><a class="btn btn--quiet" href="/admin/settings/customization/images">Reset</a><% } %>
    <span class="muted small"><%= images.length %> image<%= images.length === 1 ? '' : 's' %></span>
  </form>

  <%# One row each, closed: thumbnail, name and size. The chevron opens it
      to the snippets. A <details>, so no script. Every row starts closed; the
      one just uploaded is highlighted by :target, not opened. %>
  <div class="image-list">
    <% images.forEach(function (image) { %>
      <details class="card image-row" id="image-<%= image.id %>">
        <summary class="image-row__summary">
          <span class="image-row__thumb"><img src="<%= image.webSrc %>" alt=""></span>
          <span class="image-row__title">
            <strong><%= image.name %></strong><% if (image.is_private) { %> <span class="pill pill--muted">Private</span><% } %>
            <span class="small muted">
              <%= image.original_name %> &middot;
              <%= Math.max(1, Math.round(image.byte_size / 1024)) %> KB &middot;
              uploaded <%= formatRelative(image.created_at) %>
            </span>
          </span>
          <span class="image-row__copies">
            <%- include('../../partials/copy-button', { text: '<img src="' + image.webSrc + '" alt="' + image.name + '">', label: 'Copy the web page snippet', tag: 'Web' }) %>
            <% if (!image.emailProblem) { %>
              <%- include('../../partials/copy-button', { text: '<img src="cid:' + image.cid + '" alt="' + image.name + '">', label: 'Copy the email snippet', tag: 'Mail' }) %>
            <% } %>
            <%- include('../../partials/copy-button', { text: image.absoluteSrc, label: 'Copy the address', tag: 'Link' }) %>
            <%# In the header, so it shows whether the row is open or not. A
                <form> may not sit inside a <summary>, so the button names the
                form below the row instead. %>
            <%- include('../../partials/bin-button', { label: 'Remove ' + image.name, form: 'delete-' + image.id }) %>
          </span>
          <svg class="image-row__chevron" viewBox="0 0 16 16" width="16" height="16" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 6l4 4 4-4"/>
          </svg>
        </summary>

        <div class="image-row__body stack">
          <%# One click selects a whole snippet, ready to copy. %>
          <div class="field">
            <span class="small"><strong>For a web page</strong> - requester portal, approval page</span>
            <div class="snippet-row">
              <code class="copyable snippet">&lt;img src="<%= image.webSrc %>" alt="<%= image.name %>"&gt;</code>
              <%- include('../../partials/copy-button', { text: '<img src="' + image.webSrc + '" alt="' + image.name + '">', label: 'Copy the web page snippet' }) %>
            </div>
          </div>

          <div class="field">
            <div class="label-row">
              <span class="small"><strong>For an email</strong> - notification templates</span>
              <%- include('../../partials/info', { text: 'Embedded in the message as an inline attachment, like the logo. Remote image links are blocked by Outlook and Gmail until the recipient allows images.' }) %>
            </div>
            <% if (image.emailProblem) { %>
              <p class="hint"><%= image.emailProblem %></p>
            <% } else { %>
              <div class="snippet-row">
                <code class="copyable snippet">&lt;img src="cid:<%= image.cid %>" alt="<%= image.name %>"&gt;</code>
                <%- include('../../partials/copy-button', { text: '<img src="cid:' + image.cid + '" alt="' + image.name + '">', label: 'Copy the email snippet' }) %>
              </div>
            <% } %>
          </div>

          <form method="post" action="/admin/settings/customization/images/<%= image.id %>/private" class="inline-form image-row__privacy">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
            <% if (image.is_private) { %>
              <span class="small">Private: only signed-in people can load it.</span>
              <button type="submit" class="btn btn--small">Make public</button>
            <% } else { %>
              <input type="hidden" name="isPrivate" value="on">
              <span class="small">Public: anybody with the address can load it.</span>
              <button type="submit" class="btn btn--small">Make private</button>
            <% } %>
          </form>

          <div class="field">
            <span class="small"><strong>Address</strong></span>
            <div class="snippet-row">
              <code class="copyable snippet"><%= image.absoluteSrc %></code>
              <%- include('../../partials/copy-button', { text: image.absoluteSrc, label: 'Copy the address' }) %>
            </div>
          </div>

        </div>
      </details>
      <form id="delete-<%= image.id %>" method="post" action="/admin/settings/customization/images/<%= image.id %>/delete" hidden>
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
      </form>
    <% }); %>
  </div>
<% } %>

<%# A :target dialog, reopened by openDialog when an upload is refused. %>
<div class="dialog<%= openDialog === 'upload-image' ? ' dialog--open' : '' %>" id="upload-image">
  <a class="dialog__backdrop" href="#top" aria-label="Close"></a>
  <div class="dialog__panel" role="dialog" aria-modal="true" aria-labelledby="upload-image-title">
    <div class="dialog__head">
      <h2 id="upload-image-title">Upload image</h2>
      <a class="dialog__close" href="#top" aria-label="Close">&times;</a>
    </div>

    <form method="post" action="/admin/settings/customization/images" enctype="multipart/form-data" class="stack">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
      <% if (problems.length > 0) { %>
        <p class="field-error" role="alert"><%= problems[0] %></p>
      <% } %>
      <div class="field">
        <label for="image-name">Name</label>
        <input id="image-name" name="name" type="text" maxlength="80" required
               placeholder="For example: Header banner" value="<%= nameValue %>">
      </div>
      <div class="field">
        <label for="image-file">Image</label>
        <input id="image-file" name="image" type="file" accept="<%= accept %>" required>
        <p class="hint"><%= accept.split(',').join(' ') %>, up to <%= maxKb %> KB. Email shows PNG, JPEG and GIF up to 100 KB.</p>
      </div>
      <div class="label-row">
        <label class="check">
          <input type="checkbox" name="isPrivate" value="on">
          Private - only for signed-in people
        </label>
        <%- include('../../partials/info', { text: 'Its address answers only somebody signed in to the service desk; anybody else gets "not found". Emails still show it, because the image travels inside the message. Not for the sign-in page, which is seen before signing in.' }) %>
      </div>
      <div class="dialog__actions">
        <button type="submit" class="btn btn--primary">Upload image</button>
        <a class="btn btn--quiet" href="#top">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%# The second page allowed a script of ours: copy buttons. See copy.js. %>
<script src="/assets/js/copy.js?v=<%= locals.assetVersion %>" defer></script>

<%- include('_layout_end') %>
