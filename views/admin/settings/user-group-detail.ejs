<%- include('_layout') %>

<%- include('_group-tabs') %>

<p class="breadcrumb"><%- include('../../partials/back-link', { href: '/admin/settings/groups/users', label: 'All user groups' }) %></p>

<form method="post" action="/admin/settings/groups/users/<%= group.id %>" class="card stack">
  <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
  <h2 class="section-title">Details</h2>

  <% if (errors.form) { %>
    <p class="field-error" role="alert"><%= errors.form %></p>
  <% } %>

  <div class="grid-2">
    <div class="field">
      <label for="name">Name <span class="required">*</span></label>
      <input id="name" name="name" type="text" required minlength="2" maxlength="80"
             value="<%= group.name %>">
      <% if (errors.name) { %><p class="field-error" role="alert"><%= errors.name %></p><% } %>
    </div>

    <div class="field">
      <label for="description">Description</label>
      <input id="description" name="description" type="text" maxlength="500"
             value="<%= group.description %>">
    </div>
  </div>

  <div class="field">
    <div class="label-row">
      <label class="checkbox">
        <input type="checkbox" name="isActive" value="1"<%= group.is_active ? ' checked' : '' %>>
        Use this group when deciding who sees a template
      </label>
      <%- include('../../partials/info', { text: 'Clear to retire the group. Its members no longer receive templates restricted to it and see only unrestricted templates.' }) %>
    </div>
  </div>

  <div class="actions">
    <button type="submit" class="btn btn--primary">Save</button>
    <a class="btn btn--quiet" href="/admin/settings/groups/users">Cancel</a>
  </div>
</form>

<%# ------------------------------------------------------------------ rules %>
<div class="card stack" id="rules">
  <div class="builder__head">
    <div>
      <h2 class="section-title">Rules</h2>
      <p class="small muted">
        Anyone matching <strong>any</strong> rule is in the group, recalculated
        when an account changes.
      </p>
    </div>
    <a class="btn btn--small" href="#add-rule">Add a rule</a>
  </div>

  <% if (rules.length === 0) { %>
    <p class="small muted">No rules. Membership is whoever is named below.</p>
  <% } else { %>
    <ul class="task-list rule-list">
      <% rules.forEach(function (rule) { %>
        <li class="task-list__item">
          <span>
            <strong><%= attributeLabels[rule.attribute] %></strong>
            <%= operatorLabels[rule.operator] %>
            <% if (valueless.indexOf(rule.operator) === -1) { %>
              <strong>&ldquo;<%= rule.value %>&rdquo;</strong>
            <% } %>
          </span>
          <form method="post" class="inline"
                action="/admin/settings/groups/users/<%= group.id %>/rules/<%= rule.id %>/delete">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
            <%- include('../../partials/bin-button', { label: 'Remove this rule' }) %>
          </form>
        </li>
      <% }); %>
    </ul>

    <form method="post" action="/admin/settings/groups/users/<%= group.id %>/rules/apply">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
      <button type="submit" class="btn btn--small">Recalculate now</button>
      <span class="hint">
        Membership already updates when an account changes; this is for when a
        directory changed without anyone signing in.
      </span>
    </form>
  <% } %>
</div>

<%# ---------------------------------------------------------------- members %>
<div class="card stack">
  <h2 class="section-title" id="members">Members</h2>

  <p class="small muted">
    Ticked by hand below, or added by a rule. A rule member cannot be unticked
    here - change the rule instead.
  </p>

  <%- include('_member-picker', {
    action: '/admin/settings/groups/users/' + group.id,
    members: members,
    candidates: candidates,
    memberIds: memberIds,
    memberPage: memberPage,
    manualIds: manualIds,
    total: total,
    q: q,
    size: size,
    page: page,
  }) %>
</div>

<div class="card stack">
  <h2 class="section-title">Remove</h2>
  <p class="small">
    Templates restricted to this group become available to everybody again.
    Nothing is deleted.
  </p>
  <form method="post" action="/admin/settings/groups/users/<%= group.id %>/delete" class="inline-form">
    <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
    <button type="submit" class="btn btn--small btn--danger">Remove this group</button>
  </form>
</div>

<div class="dialog<%= openDialog === 'add-rule' ? ' dialog--open' : '' %>" id="add-rule">
  <a class="dialog__backdrop" href="#top" aria-label="Close"></a>
  <div class="dialog__panel" role="dialog" aria-modal="true" aria-labelledby="add-rule-title">
    <div class="dialog__head">
      <h2 id="add-rule-title">Add a rule</h2>
      <a class="dialog__close" href="#top" aria-label="Close">&times;</a>
    </div>

    <form method="post" action="/admin/settings/groups/users/<%= group.id %>/rules" class="stack">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">

      <% if (openDialog === 'add-rule' && errors.form) { %>
        <p class="field-error" role="alert"><%= errors.form %></p>
      <% } %>

      <div class="grid-2">
        <div class="field">
          <label for="attribute">Attribute</label>
          <select id="attribute" name="attribute">
            <% ruleAttributes.forEach(function (attribute) { %>
              <option value="<%= attribute %>"><%= attributeLabels[attribute] %></option>
            <% }); %>
          </select>
        </div>

        <div class="field">
          <label for="operator">Comparison</label>
          <select id="operator" name="operator">
            <% ruleOperators.forEach(function (operator) { %>
              <option value="<%= operator %>"><%= operatorLabels[operator] %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <div class="field">
        <div class="label-row">
          <label for="value">Value</label>
          <%- include('../../partials/info', { text: 'Matching is case-insensitive. Leave empty only with &ldquo;is set&rdquo; or &ldquo;is empty&rdquo;.' }) %>
        </div>
        <input id="value" name="value" type="text" maxlength="200" placeholder="e.g. HR">
      </div>

      <div class="dialog__actions">
        <button type="submit" class="btn btn--primary">Add rule</button>
        <a class="btn btn--quiet" href="#top">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('_layout_end') %>
