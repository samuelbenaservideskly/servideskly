<%- include('_layout') %>

<form method="get" action="/admin/settings/audit" class="filters">
  <span class="filters__field">
    <label for="action">Action</label>
    <select id="action" name="action">
      <option value="">Any action</option>
      <% actionGroups.forEach(function (group) { %>
        <optgroup label="<%= group.label %>">
          <% if (group.prefix) { %>
            <option value="<%= group.prefix %>"<%= filters.action === group.prefix ? ' selected' : '' %>>All <%= group.label.toLowerCase() %></option>
          <% } %>
          <% group.actions.forEach(function (a) { %>
            <option value="<%= a.value %>"<%= filters.action === a.value ? ' selected' : '' %>><%= a.label %></option>
          <% }); %>
        </optgroup>
      <% }); %>
    </select>
  </span>

  <span class="filters__field">
    <label for="outcome">Outcome</label>
    <select id="outcome" name="outcome">
      <option value="any"<%= filters.outcome === 'any' ? ' selected' : '' %>>Any</option>
      <option value="success"<%= filters.outcome === 'success' ? ' selected' : '' %>>Success</option>
      <option value="failure"<%= filters.outcome === 'failure' ? ' selected' : '' %>>Failure</option>
    </select>
  </span>

  <button type="submit" class="btn">Filter</button>
  <a class="btn btn--quiet" href="/admin/settings/audit">Reset</a>
</form>

<% if (entries.length === 0) { %>
  <p class="muted">No audit entries match this filter.</p>
<% } else { %>
  <%#
    One line per entry - when, who, what, how it went - and the rest behind
    Details (21 Oct 2026: seven columns squeezed the detail until it broke
    mid-word). A <details> per entry, so no script and a keyboard opens it.
  %>
  <div class="card card--flush audit-list">
    <div class="audit-row audit-row--head" aria-hidden="true">
      <span>When</span><span>Actor</span><span>Action</span><span>Outcome</span><span></span>
    </div>
    <% entries.forEach(function (entry) { var pairs = detailPairs(entry.detail); %>
      <details class="audit-entry">
        <summary class="audit-row">
          <span class="audit-row__when"><%= formatDateTime(entry.created_at) %></span>
          <span class="audit-row__who" title="<%= entry.actor_email || '' %>"><%= entry.actor_email || 'anonymous' %></span>
          <span class="audit-row__action mono"><%= entry.action %></span>
          <span><span class="pill pill--<%= entry.outcome === 'success' ? 'resolved' : 'urgent' %>"><%= entry.outcome %></span></span>
          <span class="audit-row__more">Details</span>
        </summary>
        <dl class="audit-detail">
          <% if (entry.target_type) { %><dt>Target</dt><dd><%= entry.target_type %> <span class="mono"><%= entry.target_id || '' %></span></dd><% } %>
          <% if (entry.ip) { %><dt>Client IP</dt><dd class="mono"><%= entry.ip %></dd><% } %>
          <% pairs.forEach(function (pair) { %><dt><%= pair[0] %></dt><dd><%= pair[1] %></dd><% }); %>
          <% if (!entry.target_type && !entry.ip && pairs.length === 0) { %><dt>Detail</dt><dd class="muted">Nothing more was recorded.</dd><% } %>
        </dl>
      </details>
    <% }); %>
  </div>

  <% if (pageCount > 1) { %>
    <nav class="pagination" aria-label="Pagination">
      <% if (page > 1) { %>
        <a class="btn btn--quiet" href="/admin/settings/audit<%= queryString({ action: filters.action, outcome: filters.outcome, page: page - 1 }) %>">Previous</a>
      <% } %>
      <span class="muted">Page <%= page %> of <%= pageCount %></span>
      <% if (page < pageCount) { %>
        <a class="btn btn--quiet" href="/admin/settings/audit<%= queryString({ action: filters.action, outcome: filters.outcome, page: page + 1 }) %>">Next</a>
      <% } %>
    </nav>
  <% } %>
<% } %>

<%- include('_layout_end') %>
