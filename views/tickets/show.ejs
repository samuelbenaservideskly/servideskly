<%- include('../partials/header') %>
<%#
  The ticket page (redesigned 21 Oct 2026, "it looks grouped up"):

  - one conversation, in time order - the request, every reply and note, and
    each file shown with the message it came with (services/ticket-timeline.ts);
  - one reply box at the end of it, Reply or Internal note as two tabs, that
    takes files too (POST /:id/comments; the chips are reply-files.js);
  - one panel of properties at the side, each one once and changeable there,
    in place of a Details card and a Triage form that said everything twice;
  - the retired Hardware / Software category is gone from the page.
%>
<%
  var viewable = function (file) { return viewableTypes.indexOf(file.content_type) !== -1; };
  var initials = function (name) {
    return String(name || '?').replace(/\s*-\s*\(.*\)\s*$/, '').split(/\s+/).filter(Boolean).slice(0, 2)
      .map(function (w) { return w.charAt(0).toUpperCase(); }).join('') || '?';
  };
  var draft = locals.replyDraft || null;
  var replyErrors = (locals.flashMessages || []).filter(function (m) { return m.where === 'reply' || m.where === 'attachments'; });
%>

<div class="tk-head">
  <div class="tk-head__main">
    <p class="tk-head__ref"><span class="ticket-ref"><%= ticket.reference %></span> <span aria-hidden="true">&middot;</span> <%= typeLabels[ticket.type] %></p>
    <h1><%= ticket.title %></h1>
    <div class="tk-head__meta">
      <span class="pill pill--<%= ticket.status %>"><%= statusLabels[ticket.status] %></span>
      <span class="pill pill--p-<%= ticket.priority %>"><%= priorityLabels[ticket.priority] %></span>
      <% if (ticket.parent_id) { %>
        <span class="small muted"><%= t('A task under') %> <a href="/tickets/<%= ticket.parent_id %>"><%= ticket.parent_title %></a></span>
      <% } %>
    </div>
  </div>
  <div class="page-head__actions">
    <%# Assign to me: one click with one group (or none); a popup to pick
        the group when the technician is in several. %>
    <% if (locals.isStaff && locals.can && can('tickets.edit') && locals.currentUser && ticket.assignee_id !== currentUser.id && ticket.status !== 'closed' && ticket.status !== 'cancelled') { %>
      <% if (myGroups.length > 1) { %>
        <a class="btn btn--primary" href="#assign-me"><%- include('../partials/icon', { name: 'userPlus' }) %> <%= t('Assign to me') %></a>
      <% } else { %>
        <form method="post" action="/tickets/<%= ticket.id %>/assign-me" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
          <button type="submit" class="btn btn--primary" title="<%= myGroups.length === 1 ? tx('Assign it to you, in {0}', [myGroups[0].name]) : t('Assign it to you') %>"><%- include('../partials/icon', { name: 'userPlus' }) %> <%= t('Assign to me') %></button>
        </form>
      <% } %>
    <% } %>
    <a class="btn btn--quiet" href="/tickets">Back to tickets</a>
  </div>
</div>

<% if (locals.isStaff && myGroups.length > 1) { %>
  <div class="dialog" id="assign-me">
    <a class="dialog__backdrop" href="#top" aria-label="Close"></a>
    <div class="dialog__panel" role="dialog" aria-modal="true" aria-labelledby="assign-me-title">
      <div class="dialog__head"><h2 id="assign-me-title">Assign to me</h2><a class="dialog__close" href="#top" aria-label="Close">&times;</a></div>
      <form method="post" action="/tickets/<%= ticket.id %>/assign-me" class="stack">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
        <fieldset class="field">
          <legend>In which of your groups?</legend>
          <div class="check-list">
            <% var preset = myGroups.some(function (g) { return g.id === ticket.group_id; }) ? ticket.group_id : myGroups[0].id; %>
            <% myGroups.forEach(function (g) { %>
              <label class="check"><input type="radio" name="groupId" value="<%= g.id %>"<%= g.id === preset ? ' checked' : '' %> required><span><%= g.name %><%= g.id === ticket.group_id ? ' ' + t('(its group now)') : '' %></span></label>
            <% }); %>
          </div>
        </fieldset>
        <div class="dialog__actions">
          <button type="submit" class="btn btn--primary">Assign to me</button>
          <a class="btn btn--quiet" href="#top">Cancel</a>
        </div>
      </form>
    </div>
  </div>
<% } %>

<%
  function fileList(files) { %>
  <ul class="tk-files">
    <% files.forEach(function (file) { %>
      <li class="tk-file<%= file.is_internal ? ' tk-file--internal' : '' %>">
        <%#
          A type the browser can show opens in a tab of its own; ?download is
          beside it for a file somebody wants to keep.
        -%>
        <a class="tk-file__name" href="/tickets/<%= ticket.id %>/attachments/<%= file.id %>" title="<%= file.filename %>"<% if (viewable(file)) { %> target="_blank" rel="noopener"<% } %>>
          <%- include('../partials/icon', { name: 'file' }) %><span><%= shortFileName(file.filename, 40) %></span>
        </a>
        <span class="tk-file__meta">
          <%= formatBytes(file.byte_size) %>
          <% if (viewable(file)) { %> &middot; <a href="/tickets/<%= ticket.id %>/attachments/<%= file.id %>?download"><%= t('Download') %></a><% } %>
          <% if (file.is_internal) { %> &middot; <%= t('Internal') %><% } %>
          <% if (file.emailed_at) { %> &middot; <span title="<%= tx('Emailed to the requester {0}', [formatDateTime(file.emailed_at)]) %>"><%= t('Emailed') %></span><% } %>
        </span>
        <% if (locals.isStaff || file.uploaded_by === locals.currentUser.id) { %>
          <form method="post" action="/tickets/<%= ticket.id %>/attachments/<%= file.id %>/delete" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
            <%- include('../partials/bin-button', { label: tx('Remove {0}', [file.filename]) }) %>
          </form>
        <% } %>
      </li>
    <% }); %>
  </ul>
<% } %>

<div class="columns tk-layout">
  <div class="col-main">
    <section class="tk-thread" id="conversation" aria-label="<%= t('Conversation') %>">
      <% timeline.forEach(function (entry) { %>
        <% if (entry.kind === 'request') { var who = locals.raisedByName || ticket.requester_name; %>
          <article class="tk-entry tk-entry--request">
            <span class="tk-avatar" aria-hidden="true"><%= initials(who) %></span>
            <div class="tk-entry__body">
              <header class="tk-entry__head">
                <strong><%= who %></strong>
                <span class="tk-entry__when" title="<%= formatDateTime(ticket.created_at) %>">
                  <%= locals.raisedByName ? tx('raised this for {0}', [ticket.requester_name]) : t('raised this') %> &middot; <%= formatRelative(ticket.created_at) %>
                </span>
              </header>
              <div class="prose"><%- textWithImages(ticket.description, ticket.id, entry.files, attachments) %></div>
              <% if (entry.files.length) { fileList(entry.files); } %>
            </div>
          </article>
        <% } else if (entry.kind === 'comment') { var c = entry.comment; %>
          <article class="tk-entry<%= c.is_internal ? ' tk-entry--internal' : '' %><%= c.author_role !== 'user' ? ' tk-entry--staff' : '' %>">
            <span class="tk-avatar" aria-hidden="true"><%= initials(c.author_name) %></span>
            <div class="tk-entry__body">
              <header class="tk-entry__head">
                <strong><%= c.author_name %></strong>
                <% if (c.author_role !== 'user') { %><span class="badge badge--<%= c.author_role %>"><%= roleLabel(c.author_role) %></span><% } %>
                <% if (c.is_internal) { %><span class="badge badge--internal"><%= t('Internal note') %></span><% } %>
                <span class="tk-entry__when" title="<%= formatDateTime(c.created_at) %>"><%= formatRelative(c.created_at) %></span>
                <% if (locals.mayDeleteComments) { %>
                  <span class="tk-entry__tools"><%- include('../partials/bin-button', { label: t('Delete this comment'), href: '#delete-comment-' + c.id }) %></span>
                <% } %>
              </header>
              <div class="prose"><%- textWithImages(c.body, ticket.id, entry.files, attachments) %></div>
              <% if (entry.files.length) { fileList(entry.files); } %>
            </div>
          </article>
          <% if (locals.mayDeleteComments) { %>
            <%# A :target confirmation, like deleting the ticket. %>
            <div class="dialog" id="delete-comment-<%= c.id %>">
              <a class="dialog__backdrop" href="#conversation" aria-label="Close"></a>
              <div class="dialog__panel" role="dialog" aria-modal="true" aria-labelledby="delete-comment-<%= c.id %>-title">
                <div class="dialog__head"><h2 id="delete-comment-<%= c.id %>-title">Delete this comment?</h2><a class="dialog__close" href="#conversation" aria-label="Close">&times;</a></div>
                <form method="post" action="/tickets/<%= ticket.id %>/comments/<%= c.id %>/delete" class="stack">
                  <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                  <p class="small">It is removed for good. The history keeps a line saying who deleted it; files posted with it stay on the ticket.</p>
                  <div class="dialog__actions">
                    <a class="btn btn--quiet" href="#conversation">Cancel</a>
                    <button type="submit" class="btn btn--danger">Delete comment</button>
                  </div>
                </form>
              </div>
            </div>
          <% } %>
        <% } else { var by = entry.files[0].uploader_name; %>
          <article class="tk-entry tk-entry--files<%= entry.internal ? ' tk-entry--internal' : '' %>">
            <span class="tk-avatar tk-avatar--icon" aria-hidden="true"><%- include('../partials/icon', { name: 'paperclip' }) %></span>
            <div class="tk-entry__body">
              <header class="tk-entry__head">
                <strong><%= by %></strong>
                <span class="tk-entry__when" title="<%= formatDateTime(entry.at) %>"><%= entry.files.length === 1 ? t('attached a file') : tx('attached {0} files', [entry.files.length]) %> &middot; <%= formatRelative(entry.at) %></span>
              </header>
              <% fileList(entry.files); %>
            </div>
          </article>
        <% } %>
      <% }); %>
    </section>

    <%#
      The reply box. Two radios before everything else in the form make the
      tabs (the mailbox dialog's technique: no script), and say what is sent -
      "internal" is "on" for a note. Files go with the words; the script only
      makes the list of chosen files nicer, and without it the file picker is
      an ordinary one.
    %>
    <form method="post" action="/tickets/<%= ticket.id %>/comments" enctype="multipart/form-data"
          class="card tk-reply" id="reply" data-file-form
          data-remove-label="<%= t('Remove') %>">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
      <% if (locals.isStaff && can('tickets.internal')) { %>
        <input type="radio" name="internal" value="" id="reply-public" class="kind-radio tk-reply__public"<%= draft && draft.internal ? '' : ' checked' %>>
        <input type="radio" name="internal" value="on" id="reply-internal" class="kind-radio tk-reply__internal"<%= draft && draft.internal ? ' checked' : '' %>>
        <div class="tk-tabs">
          <label for="reply-public" class="tk-tab tk-tab--public"><%= t('Reply to requester') %></label>
          <label for="reply-internal" class="tk-tab tk-tab--internal"><%- include('../partials/icon', { name: 'lock' }) %> <%= t('Internal note') %></label>
        </div>
      <% } %>

      <label for="reply-body" class="visually-hidden"><%= locals.isStaff ? t('Reply') : t('Add a comment') %></label>
      <textarea id="reply-body" name="body" rows="4" maxlength="20000" data-paste-images
                placeholder="<%= locals.isStaff ? t('Write a reply...') : t('Add a comment...') %>"><%= draft ? draft.body : '' %></textarea>

      <% replyErrors.forEach(function (message) { %>
        <p class="field-error" role="alert"><%= message.message %></p>
      <% }); %>

      <% if (attachmentsEnabled) { %>
        <ul class="tk-chips" data-file-list hidden></ul>
      <% } %>

      <div class="tk-reply__bar">
        <% if (attachmentsEnabled) { %>
          <div class="tk-reply__attach">
            <label for="reply-files" class="btn btn--small tk-reply__add" data-file-add hidden>
              <%- include('../partials/icon', { name: 'paperclip' }) %> <%= t('Add files') %>
            </label>
            <input id="reply-files" name="files" type="file" multiple accept="<%= attachmentAccept %>" class="tk-reply__input" data-file-input>
            <%- include('../partials/info', {
              text: tx('Up to {0} files per ticket, {1} each. Accepted: {2}.', [attachmentMaxPerTicket, attachmentMaxLabel, attachmentAccept.split(',').join(' ')]),
            }) %>
          </div>
        <% } %>
        <div class="tk-reply__go">
          <% if (locals.isStaff) { %>
            <%#
              Unticked, a reply and its files are only added to the ticket
              (21 Oct 2026). notifyChoice says this form has the box, so a
              form without it still emails, as replies always did.
            %>
            <input type="hidden" name="notifyChoice" value="1">
            <label class="check tk-notify">
              <input type="checkbox" name="notify" value="on"<%= draft && draft.notify === false ? '' : ' checked' %>>
              <%= t('Email the requester') %>
            </label>
          <% } %>
          <button type="submit" class="btn btn--primary tk-reply__send">
            <% if (locals.isStaff) { %>
              <span class="tk-send--public tk-when--emailed"><%= t('Send reply') %></span>
              <span class="tk-send--public tk-when--quiet"><%= t('Add to ticket') %></span>
              <span class="tk-send--internal"><%= t('Add internal note') %></span>
            <% } else { %>
              <%= t('Send') %>
            <% } %>
          </button>
        </div>
      </div>
      <p class="tk-reply__hint">
        <% if (locals.isStaff) { %>
          <span class="tk-send--public tk-when--emailed"><%= t('The requester is emailed your reply and its files.') %></span>
          <span class="tk-send--public tk-when--quiet"><%= t('Nobody is emailed: the reply and its files are only added to the ticket, where the requester can read them.') %></span>
          <span class="tk-send--internal"><%= t('Only the service desk sees a note and its files.') %></span>
        <% } %>
        <%= t('Do not attach anything containing passwords or other credentials.') %>
      </p>
    </form>
  </div>

  <aside class="col-side">
    <% if (locals.sla) { %>
      <%# The two clocks as cards: time to go (or overdue), and when it is due. %>
      <div class="sla-clocks">
        <% [[t('First response'), sla.response], [t('Resolution'), sla.resolution]].forEach(function (pair) {
             var c = pair[1], left = new Date(c.due).getTime() - Date.now(); %>
          <div class="sla-clock sla-clock--<%= c.state %>">
            <small><%= pair[0] %></small>
            <% if (c.doneAt) { %>
              <b><%= c.state === 'breached' ? t('Missed') : t('Met') %></b>
              <span class="sla-clock__sub">Done <%= formatDateTime(c.doneAt) %></span>
            <% } else if (c.state === 'paused') { %>
              <b>Paused</b>
              <span class="sla-clock__sub">While on hold - due <%= formatDateTime(c.due) %></span>
            <% } else { %>
              <b><%= formatDuration(left) %> <span><%= left >= 0 ? t('to go') : t('overdue') %></span></b>
              <span class="sla-clock__sub">Due <%= formatDateTime(c.due) %></span>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } %>

    <%# Changing a ticket is a permission (custom roles, part 2); without it, the details read only. %>
    <% if (locals.isStaff && can('tickets.edit')) { %>
      <form method="post" action="/tickets/<%= ticket.id %>/update" class="card tk-props" id="properties">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">

        <div class="tk-prop">
          <label for="status-select">Status</label>
          <select id="status-select" name="status">
            <% statuses.forEach(function (status) { %>
              <option value="<%= status %>"<%= ticket.status === status ? ' selected' : '' %>><%= statusLabels[status] %></option>
            <% }); %>
          </select>
        </div>

        <%#
          Required only when the status is changing to on hold, which the
          server decides - a `required` attribute here would block every
          other change to a ticket that is already on hold. Each note shows
          only while its status is chosen, by CSS.
        -%>
        <div class="field status-note status-note--pending">
          <div class="label-row">
            <label for="hold-reason">On-hold reason</label>
            <%- include('../partials/info', { text: 'Required when placing a ticket on hold. It is posted as a comment visible to the requester, so it is clear what the ticket is waiting for.' }) %>
          </div>
          <input id="hold-reason" name="holdReason" type="text" maxlength="2000"
                 placeholder="Waiting for the supplier to confirm a delivery date">
        </div>
        <div class="field status-note status-note--cancelled">
          <div class="label-row">
            <label for="cancel-note">Cancellation note<% if (locals.requireCancelNote) { %> <span class="required">*</span><% } %></label>
            <%- include('../partials/info', { text: 'Posted as a comment the requester can see, and sent with the status notification.' }) %>
          </div>
          <input id="cancel-note" name="cancelNote" type="text" maxlength="2000"
                 placeholder="No longer needed - the requester found the file">
        </div>
        <div class="field status-note status-note--resolved">
          <div class="label-row">
            <label for="resolve-note">Resolution note<% if (locals.requireResolveNote) { %> <span class="required">*</span><% } %></label>
            <%- include('../partials/info', { text: 'Posted as a comment the requester can see, and sent with the resolved notification.' }) %>
          </div>
          <input id="resolve-note" name="resolveNote" type="text" maxlength="2000"
                 placeholder="Replaced the toner; test page printed">
        </div>

        <div class="tk-prop">
          <label for="priority-select">Priority</label>
          <select id="priority-select" name="priority">
            <% priorities.forEach(function (priority) { %>
              <option value="<%= priority %>"<%= ticket.priority === priority ? ' selected' : '' %>><%= priorityLabels[priority] %></option>
            <% }); %>
          </select>
        </div>

        <div class="tk-prop">
          <label for="assignee-select">Assignee</label>
          <select id="assignee-select" name="assigneeId">
            <option value=""<%= ticket.assignee_id ? '' : ' selected' %>><%= t('Unassigned') %></option>
            <% staff.forEach(function (person) { %>
              <option value="<%= person.id %>"<%= ticket.assignee_id === person.id ? ' selected' : '' %>><%= person.display_name %></option>
            <% }); %>
          </select>
        </div>

        <div class="tk-prop">
          <label for="group-select">Group</label>
          <select id="group-select" name="groupId">
            <option value=""<%= ticket.group_id ? '' : ' selected' %>><%= t('Unrouted') %></option>
            <% groups.forEach(function (group) { %>
              <option value="<%= group.id %>"<%= ticket.group_id === group.id ? ' selected' : '' %>><%= group.name %></option>
            <% }); %>
          </select>
        </div>
        <% if (locals.groupManagerNames && groupManagerNames.length) { %>
          <p class="tk-prop__note"><%= groupManagerNames.length === 1 ? t('Manager') : t('Managers') %>: <%= groupManagerNames.join(', ') %></p>
        <% } %>

        <div class="tk-prop">
          <label for="category-node">Category</label>
          <select id="category-node" name="categoryId">
            <option value=""<%= ticket.category_id ? '' : ' selected' %>><%= t('Not classified') %></option>
            <% categoryOptions.forEach(function (node) { %>
              <option value="<%= node.id %>"<%= ticket.category_id === node.id ? ' selected' : '' %>><%= node.path %></option>
            <% }); %>
          </select>
        </div>

        <% (locals.flashMessages || []).filter(function (m) { return m.where === 'update'; }).forEach(function (message) { %>
          <p class="field-error" role="alert"><%= message.message %></p>
        <% }); %>

        <div class="tk-props__actions">
          <button type="submit" class="btn btn--primary">Save changes</button>
          <% if (locals.can && can('tickets.delete')) { %>
            <a class="btn btn--quiet btn--danger btn--small" href="#delete">Delete</a>
          <% } %>
        </div>

        <dl class="details tk-facts">
          <dt>Requester</dt>
          <dd id="requester">
            <% if (locals.requesterCard) { %>
              <a class="person-link" href="#requester-card"><%= ticket.requester_name %></a>
            <% } else { %>
              <%= ticket.requester_name %>
            <% } %>
            <% (locals.requesterLines || []).forEach(function (d) { %>
              <div class="small"><span class="muted"><%= t(d.label) %>:</span> <%= d.value %></div>
            <% }); %>
          </dd>
          <% if (locals.raisedByName) { %>
            <dt>Raised by</dt>
            <dd><%= raisedByName %></dd>
          <% } %>
          <dt>Created</dt>
          <dd><%= formatDateTime(ticket.created_at) %></dd>
          <dt>Updated</dt>
          <dd><%= formatDateTime(ticket.updated_at) %></dd>
          <% if (ticket.resolved_at) { %>
            <dt>Resolved</dt>
            <dd><%= formatDateTime(ticket.resolved_at) %></dd>
          <% } %>
        </dl>
      </form>
    <% } else { %>
      <div class="card">
        <dl class="details">
          <dt>Status</dt>
          <dd><span class="pill pill--<%= ticket.status %>"><%= statusLabels[ticket.status] %></span></dd>
          <dt>Priority</dt>
          <dd><span class="pill pill--p-<%= ticket.priority %>"><%= priorityLabels[ticket.priority] %></span></dd>
          <dt>Category</dt>
          <dd><%= categoryPath || t('Not classified') %></dd>
          <dt>Assignee</dt>
          <dd><%= ticket.assignee_name || t('Unassigned') %></dd>
          <% if (locals.raisedByName) { %>
            <dt>Raised by</dt>
            <dd><%= raisedByName %></dd>
          <% } %>
          <dt>Created</dt>
          <dd><%= formatDateTime(ticket.created_at) %></dd>
          <dt>Updated</dt>
          <dd><%= formatDateTime(ticket.updated_at) %></dd>
          <% if (ticket.resolved_at) { %>
            <dt>Resolved</dt>
            <dd><%= formatDateTime(ticket.resolved_at) %></dd>
          <% } %>
        </dl>
      </div>
    <% } %>

    <% if (tasks.length > 0) { %>
      <div class="card">
        <h2 class="section-title">Tasks</h2>
        <% if (ticket.close_when_tasks_done || ticket.require_tasks_done) { %>
          <p class="small muted">
            <% if (ticket.close_when_tasks_done) { %>Closes by itself when every mandatory task is resolved.<% } %>
            <% if (ticket.require_tasks_done) { %>Can be resolved only once every task is resolved or cancelled.<% } %>
          </p>
        <% } %>
        <ul class="task-list">
          <% tasks.forEach(function (task) { %>
            <li class="task-list__item">
              <span>
                <a class="link-strong" href="/tickets/<%= task.id %>"><%= task.title %></a>
                <div class="small muted ticket-ref"><%= task.reference %></div>
              </span>
              <span>
                <span class="pill pill--<%= task.status %>"><%= statusLabels[task.status] %></span>
                <% if (task.task_mandatory) { %><span class="pill pill--warn">Mandatory</span><% } %>
                <% if (task.group_name) { %>
                  <span class="muted small"><%= task.group_name %></span>
                <% } %>
              </span>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <% if (locals.isStaff) { %>
      <%# Folded: wanted now and then, and never the first thing on the page. %>
      <details class="card tk-history">
        <summary>
          <span class="section-title">History</span>
          <span class="small muted"><%= events.length === 1 ? t('1 change') : tx('{0} changes', [events.length]) %></span>
        </summary>
        <% if (events.length === 0) { %>
          <p class="muted small">No history yet.</p>
        <% } %>
        <ul class="timeline">
          <% events.forEach(function (event) { %>
            <li>
              <span class="muted small"><%= formatDateTime(event.created_at) %></span><br>
              <strong><%= event.actor_name || 'system' %></strong>
              <% if (event.kind === 'created') { %>
                created the ticket
              <% } else if (event.kind === 'field_changed') { %>
                changed <%= event.field %> from <code><%= event.old_value %></code> to <code><%= event.new_value %></code>
              <% } else if (event.kind === 'comment_deleted') { %>
                deleted a comment by <%= event.old_value %>
              <% } else if (event.kind === 'internal_note') { %>
                added an internal note
              <% } else if (event.kind === 'comment') { %>
                commented
              <% } else { %>
                <%= event.kind %>
              <% } %>
            </li>
          <% }); %>
        </ul>
      </details>

      <% if (locals.can && can('tickets.delete')) { %>
        <%#
          A :target dialog, like every other create-or-confirm popup here. It
          is reopened by the server (.dialog--open) when the delete was
          refused, so the reason that was typed and the message saying what
          was wrong are not lost.
        %>
        <% var deleteRefused = (locals.flashMessages || []).filter(function (m) { return m.where === 'delete'; }); %>
        <div class="dialog<%= deleteRefused.length ? ' dialog--open' : '' %>" id="delete">
          <a class="dialog__backdrop" href="#top" aria-label="Close"></a>
          <div class="dialog__panel" role="dialog" aria-modal="true" aria-labelledby="delete-title">
            <div class="dialog__head">
              <h2 id="delete-title">Delete this ticket</h2>
              <a class="dialog__close" href="#top" aria-label="Close">&times;</a>
            </div>

            <form method="post" action="/tickets/<%= ticket.id %>/delete" class="stack">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
              <p class="small">
                The ticket, its comments and its files are removed for good. The
                manager of its group is emailed the reason (with no manager, the
                other administrators are). To take a ticket out of the queue without
                losing it, set the status to Cancelled instead.
              </p>
              <div class="field">
                <label for="delete-reason">Reason</label>
                <input id="delete-reason" name="reason" type="text" maxlength="2000" required
                       placeholder="Raised in error and contains another customer's data">
              </div>
              <% deleteRefused.forEach(function (message) { %>
                <p class="field-error" role="alert"><%= message.message %></p>
              <% }); %>
              <div class="dialog__actions">
                <button type="submit" class="btn btn--danger">Delete this ticket</button>
                <a class="btn btn--quiet" href="#top">Cancel</a>
              </div>
            </form>
          </div>
        </div>
      <% } %>
    <% } %>
  </aside>
</div>

<% if (locals.requesterCard) { const card = requesterCard; %>
  <div class="dialog" id="requester-card">
    <a class="dialog__backdrop" href="#requester" aria-label="Close"></a>
    <div class="dialog__panel" role="dialog" aria-modal="true" aria-labelledby="requester-card-title">
      <div class="dialog__head">
        <h2 id="requester-card-title"><%= card.name %></h2>
        <a class="dialog__close" href="#requester" aria-label="Close">&times;</a>
      </div>
      <div class="stack">
        <dl class="person-card">
          <% if (card.email) { %>
            <dt>Email</dt>
            <dd><a href="mailto:<%= card.email %>"><%= card.email %></a></dd>
          <% } %>
          <% card.lines.forEach(function (l) { %>
            <dt><%= t(l.label) %></dt>
            <dd>
              <% if (l.label === 'Phone') { %><a href="tel:<%= l.value.replace(/[^0-9+]/g, '') %>"><%= l.value %></a><% } else { %><%= l.value %><% } %>
            </dd>
          <% }); %>
        </dl>
        <% if (card.id) { %>
          <p class="small muted"><%= card.open %> open, <%= card.total %> in all</p>
          <% if (card.recent.length > 0) { %>
            <ul class="person-card__tickets">
              <% card.recent.forEach(function (r) { %>
                <li>
                  <a href="/tickets/<%= r.id %>"><%= r.reference %></a>
                  <span><%= r.title %></span>
                  <span class="pill pill--<%= r.status %>"><%= statusLabels[r.status] %></span>
                </li>
              <% }); %>
            </ul>
          <% } %>
        <% } else { %>
          <p class="small muted">Sent by email from somebody without an account.</p>
        <% } %>
        <div class="dialog__actions">
          <% if (card.id) { %>
            <%# The card is a summary; the page has the rest, for every technician
                and not only an administrator. %>
            <a class="btn" href="/people/<%= card.id %>">Open their page</a>
            <a class="btn" href="/tickets?scope=all&amp;status=any&amp;requester=<%= card.id %>">All their tickets</a>
          <% } %>
          <a class="btn btn--quiet" href="#requester">Close</a>
        </div>
      </div>
    </div>
  </div>
<% } %>

<% if (attachmentsEnabled) { %>
  <script src="/assets/js/reply-files.js?v=<%= locals.assetVersion %>" defer></script>
<% } %>
<%- include('../partials/footer') %>
