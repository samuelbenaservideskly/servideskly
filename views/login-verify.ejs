<%- include('partials/header') %>

<%#
  The second step of signing in with a password, when conditional access
  asks for one: the address is outside the ranges the service desk allows,
  or it asks every password account for a code.

  The same six boxes as the code sign-in, and for the same reasons - one
  input behind them keeps paste and one-time-code autofill working with no
  script. There is no "send a new code" here: a code was sent when the
  password was accepted, and asking again would be a way to make this
  service desk send mail on demand.
%>
<div class="signin">
  <div class="card signin-card">
    <%- include("partials/signin-mark") %>
    <h1>Enter your code</h1>
    <p class="lede">
      Your password was accepted. A code has been sent to <strong><%= email %></strong>;
      it expires in 5 minutes.
    </p>

    <form method="post" action="/auth/local/verify" class="stack local-signin">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">

      <div class="field">
        <label for="code" class="visually-hidden">Sign-in code</label>
        <div class="code-entry<%= error ? ' code-entry--error' : '' %>">
          <input id="code" name="code" type="text" inputmode="numeric" required maxlength="6" pattern="[0-9]{6}"
                 autocomplete="one-time-code" spellcheck="false" autofocus title="The six digits from the email"
                 <%- error ? 'aria-describedby="code-error"' : '' %>>
        </div>
        <% if (error) { %><p class="field-error" id="code-error" role="alert"><%= error %></p><% } %>
      </div>

      <button type="submit" class="btn btn--primary btn--block">Finish signing in</button>
    </form>

    <p class="small muted">
      <a href="/login?change=1">Use a different address</a>
    </p>
  </div>
</div>

<%- include('partials/footer') %>
