<%- include('partials/header') %>

<%#
  The third step of signing in, for a password that has to change: a
  temporary one an administrator sent, one generated by an import, or one
  that has expired.

  Nothing of the service desk is reachable from here - there is no session
  yet. The sign-in is finished by choosing a password, and only then is the
  person let in. Asked for 15 Oct 2026: "you should not be even let into the
  system".
%>
<div class="signin">
  <div class="card signin-card">
    <%- include("partials/signin-mark") %>
    <h1>Choose a password</h1>
    <p class="small muted">
      The password you signed in with was temporary. Choose your own to finish.
    </p>

    <form method="post" action="/auth/local/new-password" class="stack">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">

      <%# Still sent, so a password manager knows which account it is saving. %>
      <label for="email" class="visually-hidden">Email</label>
      <input id="email" type="email" readonly value="<%= email %>" autocomplete="username" hidden>

      <div class="pw-grid pw-grid--signin">
        <div class="field">
          <label for="password">New password</label>
          <%- include('partials/password-input', { id: 'password', name: 'password', autocomplete: 'new-password' }) %>
          <% if (error) { %><p class="field-error" role="alert"><%= error %></p><% } %>
        </div>

        <div class="field">
          <label for="confirm">Confirm password</label>
          <%- include('partials/password-input', { id: 'confirm', name: 'confirm', autocomplete: 'new-password' }) %>
        </div>

        <%# The rules, ticking as they type. Drawn by the server, so the box
            says what is required even with the script blocked. %>
        <%- include('partials/password-rules') %>
      </div>

      <button type="submit" class="btn btn--primary btn--block">Save and sign in</button>
    </form>
  </div>
</div>

<%# The eye, and the ticks. See password-reveal.js. %>
<script src="/assets/js/password-reveal.js?v=<%= locals.assetVersion %>" defer></script>

<%- include('partials/footer') %>
