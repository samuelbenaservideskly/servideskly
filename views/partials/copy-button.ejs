<%# A small copy icon. `text` is what is copied, `label` names it for a screen
    reader and on hover, `tag` (optional) is a short visible word - "Web",
    "Mail" - for the closed rows where several sit side by side. Hidden until
    public/js/copy.js reveals it, so it never appears without the script. %>
<button type="button" class="copy-btn" data-copy="<%= text %>" title="<%= label %>" hidden>
  <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor"
       stroke-width="1.6" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"/>
    <path d="M10.5 5.5V3.5A1.5 1.5 0 0 0 9 2H3.5A1.5 1.5 0 0 0 2 3.5V9a1.5 1.5 0 0 0 1.5 1.5h2"/>
  </svg>
  <% if (locals.tag) { %><span class="copy-btn__tag"><%= tag %></span><% } %>
  <span class="visually-hidden"><%= label %></span>
  <span class="copy-btn__status" aria-live="polite"></span>
</button>
