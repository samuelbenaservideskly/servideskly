<%# A password box with an eye that shows what was typed (password-reveal.js).
    Without the script the eye stays hidden and it is an ordinary password
    box. Takes id, name, and optionally value, required, autocomplete,
    placeholder, describedBy. %>
<span class="password-reveal">
  <input id="<%= id %>" name="<%= name %>" type="password" maxlength="200"
         value="<%= locals.value || '' %>" autocomplete="<%= locals.autocomplete || 'new-password' %>"
         <%- locals.required ? 'required' : '' %>
         <%- locals.placeholder ? 'placeholder="' + String(locals.placeholder).replace(/"/g, '&quot;') + '"' : '' %>
         <%- locals.describedBy ? 'aria-describedby="' + describedBy + '"' : '' %>
         spellcheck="false" data-reveal>
  <button type="button" class="password-reveal__toggle" aria-label="Show password" aria-pressed="false" aria-controls="<%= id %>" hidden>
    <span class="password-reveal__show"><%- include('icon', { name: 'eye' }) %></span>
    <span class="password-reveal__hide"><%- include('icon', { name: 'eyeOff' }) %></span>
  </button>
</span>
